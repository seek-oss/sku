{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "tags": ["-knipignore"],
  "workspaces": {
    "fixtures/configure": {
      "entry": ["sku.config.ts", "src/App.tsx"],
    },
    "fixtures/jest-test": {
      "entry": ["sku.config.ts"],
    },
    "fixtures/lint-format": {
      "entry": ["sku.config*.ts"],
    },
    "fixtures/storybook-config": {
      "entry": [
        "sku.config.ts",
        "dev-middleware.js",
        ".storybook*/**/*.{ts,tsx,js}",
      ],
    },
    "packages/create": {
      // Project templates are copied verbatim, never imported
      "ignore": ["templates/**"],
    },
    "site": {
      "entry": ["docs/.prettierrc.js", "public/redirects.js"],
    },
    "packages/pnpm-plugin": {
      "entry": ["pnpmfile.cjs", "pnpmfile.mjs"],
    },
    ".": {
      // Used in the renovate config
      "ignoreDependencies": ["renovate-config-seek"],
    },
    "packages/sku": {
      "ignoreDependencies": [
        // Private package installed by consumers
        "@seek/sku-telemetry",
        // Used indirectly by webpack for minification
        "@swc/core",
        // Used in tests
        "jest-environment-jsdom",
        // Optional peer deps
        "@storybook/react-webpack5",
        "@storybook/react-vite",
        // Needed so `declare module 'express-serve-static-core'` resolves under pnpm
        "@types/express-serve-static-core",
      ],
      "ignoreUnresolved": [
        "__sku_alias__clientEntry",
        "__sku_alias__renderEntry",
        "__sku_alias__routesEntry",
        "__sku_alias__serverEntry",
        "__sku_alias__webpackStats",
      ],
    },
    "packages/babel-plugin-display-name": {
      // Dep is referenced as a string
      "ignoreDependencies": ["@babel/preset-react"],
    },
    "tests": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"],
      // Used in tests
      "ignoreDependencies": ["webpack", "webpack-dev-server", "webpack-cli"],
    },
    "fixtures/assertion-removal": {
      "entry": [
        "src/client.tsx",
        "src/render.tsx",
        "sku.config.*",
        "jestSetup.js",
        "src/server.tsx",
      ],
      "ignoreDependencies": [
        // It definitely is used, not sure why knip thinks otherwise
        "assert",
      ],
    },
    "fixtures/braid-design-system": {
      "entry": [
        "src/static/client.tsx",
        "src/static/render.tsx",
        "src/webpack-static/client.tsx",
        "src/webpack-static/render.tsx",
        "src/ssr/client.tsx",
        "src/ssr/server.tsx",
        "src/ssr/routes.tsx",
        "sku.config.*",
        "jestSetup.js",
      ],
    },
    "fixtures/custom-output-target": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/custom-src-paths": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/display-names-prod": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/library-build": {
      "entry": [
        "src/library.js",
        "src/render.js",
        "sku.config.*",
        "src/dynamicImports/*.js",
      ],
    },
    "fixtures/library-file": {
      "entry": [
        "src/library.js",
        "src/render.js",
        "sku.config.*",
        "src/dynamicImports/*.js",
      ],
    },
    "fixtures/list-urls": {
      "entry": [
        "src/client.tsx",
        "src/render.tsx",
        "sku.config.*",
        "src/server.tsx",
      ],
    },
    "fixtures/multiple-routes": {
      "entry": [
        "src/client.jsx",
        "src/render.jsx",
        "sku.config.*",
        "setupTests.js",
      ],
      // Used by the `--convert-loadable` flag
      "ignoreDependencies": ["@sku-lib/vite"],
    },
    "fixtures/path-aliases": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/polyfills": {
      "entry": [
        "src/client.tsx",
        "src/render.tsx",
        "src/polyfills.ts",
        "sku.config.*",
      ],
      // Referenced in sku config
      "ignoreDependencies": ["@sku-private/3rd-party-polyfill"],
    },
    "fixtures/port-clash": {
      "entry": ["src/client.tsx", "sku.config.*"],
    },
    "fixtures/public-path": {
      "entry": ["src/client.jsx", "src/render.jsx", "sku.config.*"],
    },
    "fixtures/public-assets": {
      // Resolved from the public directory at build time
      "ignoreUnresolved": ["/nested/icon.png?url"],
      "entry": [
        "src/client.tsx",
        "src/render.tsx",
        "src/viteClient.tsx",
        "src/viteRender.tsx",
        "sku.config.*",
      ],
    },
    "fixtures/report-generation": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/security-controls": {
      "entry": [
        "src/client.jsx",
        "src/render.jsx",
        "sku.config.*",
        "sku-server.config.ts",
        "src/server.jsx",
        "src/serverClient.jsx",
      ],
    },
    "fixtures/sku-create": {
      // Used in tests
      "ignoreDependencies": ["@sku-lib/create"],
    },
    "fixtures/sku-test": {
      "entry": ["sku.config.*", "src/*.test.ts", "setup-test.*"],
    },
    "fixtures/sku-webpack-plugin": {
      // Used in tests
      "ignoreDependencies": ["webpack-dev-server"],
    },
    "fixtures/sku-with-https": {
      "entry": [
        "src/client.jsx",
        "src/render.jsx",
        "src/server.jsx",
        "src/serverClient.jsx",
        "sku.config.*",
        "sku-server.config.ts",
        "dev-middleware.*",
      ],
    },
    "fixtures/sort-package-json": {
      // Used in gitignored eslint config
      "ignoreDependencies": ["sku"],
      // Sample file for linting tests
      "ignore": ["src/foo.ts"],
    },
    "fixtures/source-maps": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/ssr-hello-world": {
      "entry": [
        "src/client.tsx",
        "src/server.tsx",
        "sku-build.config.ts",
        "sku-start.config.ts",
        "dev-middleware.cjs",
      ],
    },
    "fixtures/styling": {
      "entry": [
        "src/components/BlueBlock.css.ts",
        "src/client.tsx",
        "src/render.tsx",
        "src/server.tsx",
        "sku.config.*",
      ],
    },
    "fixtures/suspense": {
      "entry": [
        "src/client.jsx",
        "src/render.jsx",
        "sku.config.*",
        "setupTests.js",
      ],
    },
    "fixtures/stream-insert-html": {
      "entry": [
        "src/server.tsx",
        "src/client.tsx",
        "src/**/*.{ts,tsx}",
        "sku.config.*",
      ],
    },
    "fixtures/translations": {
      "entry": [
        "src/client.tsx",
        "src/ssr-client.tsx",
        "src/render.tsx",
        "src/vite-ssr/client.tsx",
        "src/vite-ssr/server.tsx",
        "sku.config.*",
        "sku-ssr.config.ts",
        "src/server.tsx",
        "src/vite-ssr/routes.tsx",
      ],
      "ignoreDependencies": [
        // Used by webpack bundler path
        "@vocab/webpack",
        // Used in translation files, but these aren't generated on CI during linting so knip
        // doesn't see the usage
        "@vocab/core",
      ],
    },
    "fixtures/typescript-css-modules": {
      "entry": [
        "src/client.tsx",
        "src/client-ssr.tsx",
        "src/render.tsx",
        "src/server.tsx",
        "src/setupTests.ts",
        "src/components/**/*.{ts,tsx}",
        "sku*.config.*",
      ],
    },
    "fixtures/vite-cjs-interop-apollo-client-v3": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/vite-cjs-interop-apollo-client-v4": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/vite-loadable-css-order": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
    },
    "fixtures/vite-plugins": {
      "entry": [
        "src/client.tsx",
        "src/render.tsx",
        "src/App.tsx",
        "sku.config.*",
      ],
    },
    "fixtures/vite-render-error": {
      "entry": [
        "src/client.tsx",
        "src/render.tsx",
        "sku.config.*",
        "src/renderError.tsx",
      ],
    },
    "fixtures/ssr-document": {
      "entry": [
        "src/server.tsx",
        "src/client.tsx",
        "src/routes.tsx",
        "sku.config.*",
      ],
    },
    "fixtures/ssr-data": {
      "entry": [
        "src/server.tsx",
        "src/client.tsx",
        "src/routes.tsx",
        "sku.config.*",
        "dev-middleware.js",
      ],
      "ignoreDependencies": [
        // Needed so `declare module 'express-serve-static-core'` resolves under pnpm
        "@types/express-serve-static-core",
      ],
    },
    "fixtures/ssr-sites": {
      "entry": [
        "src/server.tsx",
        "src/client.tsx",
        "src/routes.tsx",
        "sku.config.*",
      ],
    },
    "fixtures/logging": {
      "entry": [
        "src/server/middleware.ts",
        "src/shared/tracing.ts",
        "src/server/server.tsx",
        "src/client/client.tsx",
        "src/routes.tsx",
        "src/client/tracing.ts",
        "src/server/tracing.ts",
        "sku.config.*",
      ],
    },
    "fixtures/vite-compile-package-styles": {
      "entry": ["src/client.tsx", "src/render.tsx", "sku.config.*"],
      "ignoreDependencies": ["@vanilla-extract/css"],
    },
  },
}
