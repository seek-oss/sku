{
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["webpack/module", "node"],
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "./src/**/*",
    "./src/**/*.json",
    "./tsdown.config.ts",
    "./package.json"
  ],
  "exclude": ["**/@loadable"],
  "references": [
    { "path": "../../private/utils" },
    { "path": "../rolldown-plugin-unassert" },
    { "path": "../../private/tsdown" }
  ]
}
